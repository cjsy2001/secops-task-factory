{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs\" recall"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/tasks-md-reminder.mjs\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_stf_stf__stf_(advance_phase|reopen_phase|move_spec|charter_spec|capture_.*|import_tasks|set_task_status|set_task_model|checkpoint|complete_run|handoff_emit|handoff_pickup|handoff_archive|verify)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs\" pages-hook",
            "timeout": 120,
            "statusMessage": "Refreshing status pages"
          }
        ]
      }
    ]
  }
}
